[Unit]
Description=SPB production Bedrock observer (read-only)
After=network.target bedrock.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/bedrock-production-observer/observer.env
ExecStart=/usr/local/lib/spb/bedrock-production-observer.py --listen 127.0.0.1:3003
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
