[Unit]
Description=Minecraft Bedrock Dedicated Server (staging)
Requires=spb-staging-bridge.service
After=spb-staging-bridge.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /usr/local/lib/spb/bedrock-staging-control.py start
ExecStop=/usr/bin/python3 /usr/local/lib/spb/bedrock-staging-control.py stop
TimeoutStartSec=90
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
